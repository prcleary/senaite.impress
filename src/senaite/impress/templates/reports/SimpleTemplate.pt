<tal:report
i18n:domain="senaite.impress"
define="model python:view.model;
collection python:view.collection;
laboratory view/laboratory;
accredited_symbol string:★;
outofrange_symbol string:⚠;
footer python:view.get_footer_text();
report_options python:options.get('report_options', {});
attachments_per_row python:int(report_options.get('attachments_per_row', 2));
attachments_per_row python:attachments_per_row<1 and 1 or attachments_per_row;
page_width options/page_width|nothing;
page_height options/page_height|nothing;
content_width options/content_width|nothing;
content_height options/content_height|nothing;">

<!-- REPORT CONTROLS -->
<tal:t replace="structure python:view.render_controls(context, **options)" />

<!-- REPORT JS -->
<tal:t replace="structure python:view.render_js(context, **options)" />

<!-- REPORT CSS -->
<tal:css>
<style>
h1 {
font-family: Arial, sans-serif;
font-size: 10pt;
line-height: 1.4;
}
h2 {
font-family: Arial, sans-serif;
font-size: 10pt;
line-height: 1.4;
}
h3 {
font-family: Arial, sans-serif;
font-size: 10pt;
line-height: 1.4;
}
body {
font-family: Arial, sans-serif;
font-size: 10pt;
line-height: 1.4;
margin: 0;
padding: 0;
}
.header {
text-align: center;
margin-bottom: 5px;
}
.patient-info {
margin-bottom: 5px;
}
.patient-info table {
width: 100%;
border-collapse: collapse;
}
.patient-info td {
padding: 2px 5px;
vertical-align: top;
}
.report-title {
font-weight: bold;
text-align: center;
margin: 10px 0;
}
.results-table {
width: 100%;
border-collapse: collapse;
margin-bottom: 15px;
}
.results-table th, .results-table td {
border: 1px solid #ddd;
padding: 5px;
text-align: left;
}
.results-table th {
background-color: #f2f2f2;
}
.footer {
margin-top: 20px;
font-size: 9pt;
}
.comments {
margin: 15px 0;
padding: 10px;
border: 1px solid #ddd;
background-color: #f9f9f9;
}
.page-break {
page-break-after: always;
}
.avoid-break {
page-break-inside: avoid;
}
.lab-address {
text-align: center;
margin-bottom: 10px;
}
@page {
size: A4;
margin: 1cm;
@bottom-right {
vertical-align: top;
margin-top: 2mm;
font-size: 9pt;
content: "<tal:t i18n:translate=''>Page</tal:t> " counter(page) " <tal:t i18n:translate=''>of</tal:t> " counter(pages);
}
}
</style>
</tal:css>

<div class="header">
<strong>ABBAS INSTITUTE OF MEDICAL SCIENCES PATHOLOGY LABORATORY</strong>
</div>

<div class="lab-address">
Muzaffarabad, Azad Kashmir, Pakistan
</div>

<div class="patient-info">
<table class="table table-sm table-condensed">
<tr>
<td>Full Name: <a tal:on-error="nothing" tal:content="model/getPatientFullName"/></td>
<td>MRN: <a tal:on-error="nothing" tal:content="model/MedicalRecordNumber/value"/></td>
</tr>
<tr>
<td>
Age/Gender:  <a tal:on-error="nothing" tal:content="python: '%s years, %s months' % (model.getAge().years, model.getAge().months)"/> /  <a tal:condition="python: model.Sex == 'm'" tal:content="python: 'Male'" />
<a tal:condition="python: model.Sex == 'f'" tal:content="python: 'Female'" />
<a tal:condition="python: model.Sex == ''" tal:content="python: 'Unspecified'" />
</td>
<td>
Address: <a tal:on-error="nothing" tal:content="model/PatientAddress"/>
</td>
</tr>
<tr>
<td>
Date of Birth: <a tal:on-error="nothing" tal:content="python: model.getDateOfBirth()[0].strftime('%d/%B/%Y')" />
<a tal:on-error="nothing" tal:condition="python: model.getDateOfBirthEstimated()" tal:content="python: '(NB: estimated from age)'"/>
</td>
<td>Date of sample: <a tal:on-error="nothing" tal:content="python: view.to_localized_time(model.getDateSampled())"/></td>
</tr>
</table>
</div>

<!-- REPORT RESULTS -->
<tal:t replace="structure python:view.render_results(context, **options)" />

<!-- RESULTS INTERPRETATION -->
<tal:t replace="structure python:view.render_interpretations(context, **options)" />

  <div style="font-size: 0.8em; color: #555; line-height: 1.4; margin-top: 20px; border-top: 1px solid #ccc; padding-top: 10px;">
  <strong>Disclaimer:</strong> This report is intended for healthcare professionals and must be interpreted in the context of the patient's clinical presentation, history, and other diagnostic information.
  <strong>Accuracy and Limitations:</strong> While every effort is made to ensure accuracy, laboratory testing may be affected by <strong>pre-analytical, analytical, and post-analytical factors</strong>, including sample handling and technical variability. False positives and negatives are possible and do not imply negligence.
  <strong>Repeat Testing:</strong> If results are unclear or unexpected, repeat testing may be requested within <strong>24–48 hours</strong> at no additional cost, with accompanying clinical notes explaining the reason.
  <strong>Confidentiality:</strong> This report contains confidential patient data and is intended only for the authorized recipient. Unauthorized use or disclosure is prohibited.
  </div>

</tal:report>