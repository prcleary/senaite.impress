<tal:report define="model python:view.model;">
<!-- REPORT CONTROLS -->
<tal:t replace="structure python:view.render_controls(context, **options)" />

<!-- REPORT JS -->
<tal:t replace="structure python:view.render_js(context, **options)" />

<!-- REPORT CSS -->
<style>
body {
font-family: Arial, sans-serif;
font-size: 10pt;
line-height: 1.4;
margin: 0;
padding: 0;
}
.header {
text-align: center;
margin-bottom: 15px;
}
.patient-info {
margin-bottom: 15px;
}
.patient-info table {
width: 100%;
border-collapse: collapse;
}
.patient-info td {
padding: 2px 5px;
vertical-align: top;
}
.report-title {
font-weight: bold;
text-align: center;
margin: 10px 0;
}
.results-table {
width: 100%;
border-collapse: collapse;
margin-bottom: 15px;
}
.results-table th, .results-table td {
border: 1px solid #ddd;
padding: 5px;
text-align: left;
}
.results-table th {
background-color: #f2f2f2;
}
.footer {
margin-top: 20px;
font-size: 9pt;
}
.comments {
margin: 15px 0;
padding: 10px;
border: 1px solid #ddd;
background-color: #f9f9f9;
}
.page-break {
page-break-after: always;
}
.lab-address {
text-align: center;
margin-bottom: 10px;
}
</style>
